*.VC.db
.DS_Store
Thumbs.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crashlytics / build output
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Unity Version Control (Plastic) workspace data
.plastic/
ignore.conf

# Gradle cache directory
.gradle/

# Stray test file
/_probe.txt

# Unity crash-recovery backups (local only)
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
